#!/usr/bin/env python3
"""ptyxis-active-tab: paint the active tab of Ptyxis in the terminal's own colour.

Ptyxis paints its title bar with its own stylesheet (priority above the overrides) and does not publish the
terminal background colour in CSS. This script reads the palette of the default profile and writes a small
stylesheet that redefines, for the selected Ptyxis tab only, the roles used by the tab of m3e-gtk4 (--surface for
the background, --on_surface for the text) with the terminal background and foreground, per mode
(@media prefers-color-scheme, which follows Ptyxis' forced mode). Title bar and inactive tabs: the colour Ptyxis
gives its bar text (currentColor).
"Material" palette (matugen) or not found: sheet without rules (the tab keeps surface, already right).

Usage: ptyxis-active-tab [--output FILE] [--palette ID]
  default output: $XDG_CONFIG_HOME/m3e-gnome/ptyxis-active-tab.css; palette: the default profile's (gsettings).

OPTIONAL and manual: the installer does not run it and nothing imports its output (the "Material" palette that
the installer sets up needs no rule). It is for people who pick another Ptyxis palette (nord, dracula...). Run it
by hand after choosing the palette, then add this line to the END of ~/.config/gtk-4.0/gtk.css:
  @import url("file:///home/USER/.config/m3e-gnome/ptyxis-active-tab.css");
(percent-encode the path if it contains spaces or non-ASCII). Run it again after each palette change; GTK apps
re-read the CSS when they restart.
"""
import argparse
import configparser
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

DATA_HOME = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
USER_PALETTES = DATA_HOME / "org.gnome.Ptyxis/palettes"
MATERIAL = {"material"}          # matugen palette (overrides/ptyxis-material.palette): nothing to generate
COLOR = re.compile(r"^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$")
ENV = {**os.environ, "LC_ALL": "C"}      # gsettings output must not depend on the locale


def gget(schema, key):
    r = subprocess.run(["gsettings", "get", schema, key], capture_output=True, text=True, env=ENV)
    return r.stdout.strip().strip("'") if r.returncode == 0 else ""


def profile_palette():
    profile = gget("org.gnome.Ptyxis", "default-profile-uuid")
    if not re.fullmatch(r"[0-9a-f-]+", profile):
        return ""
    return gget(f"org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/{profile}/", "palette")


def read_palette(ident):
    """Text of the .palette file: the user's folder, else the palettes built into Ptyxis (gresource)."""
    f = USER_PALETTES / f"{ident}.palette"
    if f.is_file():
        return f.read_text(encoding="utf-8")
    ptyxis = shutil.which("ptyxis")
    if not ptyxis:
        return ""
    r = subprocess.run(["gresource", "extract", ptyxis, f"/org/gnome/Ptyxis/palettes/{ident}.palette"],
                       capture_output=True)
    return r.stdout.decode("utf-8", "replace") if r.returncode == 0 else ""


def faces(text):
    """{'dark'|'light': (background, text)} of a Ptyxis palette keyfile; a missing face reuses the other."""
    k = configparser.ConfigParser(interpolation=None, strict=False)
    k.optionxform = str
    k.read_string(text)
    r = {}
    for section, mode in (("Dark", "dark"), ("Light", "light")):
        if k.has_section(section):
            bg, fg = k[section].get("Background", ""), k[section].get("Foreground", "")
            if COLOR.match(bg) and COLOR.match(fg):
                r[mode] = (bg, fg)
    if not r and k.has_section("Palette"):        # single-face palette (keys in [Palette])
        bg, fg = k["Palette"].get("Background", ""), k["Palette"].get("Foreground", "")
        if COLOR.match(bg) and COLOR.match(fg):
            r["dark"] = r["light"] = (bg, fg)
    if "dark" not in r and "light" in r:
        r["dark"] = r["light"]
    if "light" not in r and "dark" in r:
        r["light"] = r["dark"]
    return r


def stylesheet(ident, f):
    head = ("/* Generated by ptyxis-active-tab - do not edit.\n"
            f" * Ptyxis palette: {ident or 'unknown'}. */\n")
    if not f:
        return head + "/* No rule: the active tab keeps the surface colour of m3e-gtk4.css. */\n"
    blocks = [head]
    for mode in ("dark", "light"):
        bg, fg = f[mode]
        blocks.append(f"@media (prefers-color-scheme: {mode}) {{\n"
                      f"  window.ptyxis-window tabbar tab:selected,\n"
                      f"  window.ptyxis-window tabbar tab:checked {{\n"
                      f"    --surface: {bg};\n"
                      f"    --on_surface: {fg};\n"
                      f"  }}\n"
                      f"}}\n")
    # Title bar and inactive tabs: text and icons in the colour Ptyxis gives its bar (currentColor), readable
    # also when Ptyxis forces dark mode while the matugen palette is light.
    blocks.append("window.ptyxis-window .top-bar {\n"
                  "  --on_surface_variant: currentColor;\n"
                  "  --on_surface: currentColor;\n"
                  "  --outline_variant: alpha(currentColor, 0.25);\n"
                  "}\n")
    return "".join(blocks)


def main(argv=None):
    a = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    a.add_argument("--output", default=str(CONFIG_HOME / "m3e-gnome/ptyxis-active-tab.css"))
    a.add_argument("--palette", default=None)
    args = a.parse_args(argv)
    ident = args.palette if args.palette is not None else profile_palette()
    if not re.fullmatch(r"[\w .+()-]*", ident or ""):
        print(f"palette identifier rejected: {ident!r}", file=sys.stderr)
        return 2
    f = {} if (not ident or ident.lower() in MATERIAL) else faces(read_palette(ident))
    output = Path(args.output)
    text = stylesheet(ident, f)
    if output.exists() and output.read_text(encoding="utf-8") == text:
        return 0
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(text, encoding="utf-8")
    print(f"ptyxis-active-tab: {output} ({ident or 'unknown palette'})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
